4;" vertex="1" parent="pg2-layer"><mxGeometry x="1200" y="450" width="420" height="104" as="geometry"/></mxCell><mxCell id="pg2-Do development-s" value="&lt;b&gt;Do development&lt;/b&gt;&lt;br&gt;implement against the tests" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;strokeWidth=1.6;fontColor=#1f2937;fontSize=13;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;" vertex="1" parent="pg2-layer"><mxGeometry x="40" y="580" width="230" height="104" as="geometry"/></mxCell><mxCell id="pg2-Do development-m" value="—" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#d1d5db;strokeWidth=1.6;fontColor=#9ca3af;fontSize=13;align=center;verticalAlign=middle;dashed=1;dashPattern=6 4;" vertex="1" parent="pg2-layer"><mxGeometry x="300" y="580" width="420" height="104" as="geometry"/></mxCell><mxCell id="pg2-Do development-a" value="Candidate: its own context, separate from Write tests" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#eaf6ee;strokeColor=#3c9d6a;strokeWidth=1.6;fontColor=#1f2937;fontSize=13;align=left;verticalAlign=middle;dashed=1;dashPattern=6 4;spacingLeft=14;spacingRight=14;" vertex="1" parent="pg2-layer"><mxGeometry x="750" y="580" width="420" height="104" as="geometry"/></mxCell><mxCell id="pg2-Do development-k" value="&lt;b&gt;Gap:&lt;/b&gt; design-system skill. How to use the component library and theme" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#fdf1e0;strokeColor=#d98324;strokeWidth=1.6;fontColor=#1f2937;fontSize=13;align=left;verticalAlign=middle;dashed=1;dashPattern=6 4;spacingLeft=14;spacingRight=14;" vertex="1" parent="pg2-layer"><mxGeometry x="1200" y="580" width="420" height="104" as="geometry"/></mxCell><mxCell id="pg2-Validate-s" value="&lt;b&gt;Validate and evaluate&lt;/b&gt;&lt;br&gt;Playwright run + match decision" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;strokeWidth=1.6;fontColor=#1f2937;fontSize=13;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;" vertex="1" parent="pg2-layer"><mxGeometry x="40" y="710" width="230" height="104" as="geometry"/></mxCell><mxCell id="pg2-Validate-m" value="Possible: Playwright MCP for the test run (decision still open)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#4a7fd0;strokeWidth=1.6;fontColor=#1f2937;fontSize=13;align=left;verticalAlign=middle;dashed=1;dashPattern=6 4;spacingLeft=14;spacingRight=14;" vertex="1" parent="pg2-layer"><mxGeometry x="300" y="710" width="420" height="104" as="geometry"/></mxCell><mxCell id="pg2-Validate-a" value="Candidate: independent evaluator, not the agent that wrote the code" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#eaf6ee;strokeColor=#3c9d6a;strokeWidth=1.6;fontColor=#1f2937;fontSize=13;align=left;verticalAlign=middle;dashed=1;dashPattern=6 4;spacingLeft=14;spacingRight=14;" vertex="1" parent="pg2-layer"><mxGeometry x="750" y="710" width="420" height="104" as="geometry"/></mxCell><mxCell id="pg2-Validate-k" value="—" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#d1d5db;strokeWidth=1.6;fontColor=#9ca3af;fontSize=13;align=center;verticalAlign=middle;dashed=1;dashPattern=6 4;" vertex="1" parent="pg2-layer"><mxGeometry x="1200" y="710" width="420" height="104" as="geometry"/></mxCell><mxCell id="pg2-FOOT" value="Confirmed from your notes: Figma MCP, persona.md, component library, theme, Figma designs. Everything dashed is a suggestion." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#6b7280;" vertex="1" parent="pg2-layer"><mxGeometry x="40" y="860" width="1400" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 - Critique" id="pg3"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0"><root><mxCell id="pg3-root"/><mxCell id="pg3-layer" parent="pg3-root"/><mxCell id="pg3-T" value="Review findings" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=22;fontColor=#1f2937;fontStyle=1;" vertex="1" parent="pg3-layer"><mxGeometry x="40" y="30" width="800" height="36" as="geometry"/></mxCell><mxCell id="pg3-T2" value="Numbers match the red badges on the Flow page. Severity is my own judgement." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#6b7280;" vertex="1" parent="pg3-layer"><mxGeometry x="40" y="72" width="1000" height="24" as="geometry"/></mxCell><mxCell id="pg3-C1" value="&lt;b style=&quot;font-size:15px&quot;&gt;1 · Security and Safety&lt;/b&gt; &lt;span style=&quot;color:#d64545&quot;&gt;(High)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#6b7280&quot;&gt;Where: Ingestion&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Issue:&lt;/b&gt; JIRA, Figma and persona text reaches the model with nothing separating data from instructions (indirect prompt injection).&lt;br&gt;&lt;br&gt;&lt;b&gt;Fix:&lt;/b&gt; Tag all ingested text as untrusted data. It may fill fields, never change the task." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d64545;strokeWidth=1.6;fontColor=#1f2937;fontSize=13;align=left;verticalAlign=top;spacingLeft=34;spacingRight=18;spacingTop=14;" vertex="1" parent="pg3-layer"><mxGeometry x="40" y="130" width="770" height="156" as="geometry"/></mxCell><mxCell id="pg3-B1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d64545;strokeColor=#d64545;" vertex="1" parent="pg3-layer"><mxGeometry x="40" y="130" width="14" height="156" as="geometry"/></mxCell><mxCell id="pg3-C2" value="&lt;b style=&quot;font-size:15px&quot;&gt;2 · Tools and MCP&lt;/b&gt; &lt;span style=&quot;color:#d98324&quot;&gt;(Medium)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#6b7280&quot;&gt;Where: Figma MCP&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Issue:&lt;/b&gt; A node ID stays the same when the design changes, so an old ticket silently resolves to outdated design.&lt;br&gt;&lt;br&gt;&lt;b&gt;Fix:&lt;/b&gt; Resolve to a version or last-modified stamp and warn when it differs from the ticket." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d98324;strokeWidth=1.6;fontColor=#1f2937;fontSize=13;align=left;verticalAlign=top;spacingLeft=34;spacingRight=18;spacingTop=14;" vertex="1" parent="pg3-layer"><mxGeometry x="850" y="130" width="770" height="156" as="geometry"/></mxCell><mxCell id="pg3-B2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d98324;strokeColor=#d98324;" vertex="1" parent="pg3-layer"><mxGeometry x="850" y="130" width="14" height="156" as="geometry"/></mxCell><mxCell id="pg3-C3" value="&lt;b style=&quot;font-size:15px&quot;&gt;3 · Evaluation&lt;/b&gt; &lt;span style=&quot;color:#d64545&quot;&gt;(High)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#6b7280&quot;&gt;Where: Match decision&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Issue:&lt;/b&gt; &#x27;Match and tests pass?&#x27; mixes Playwright pass/fail with a semantic judgement, possibly by the model that wrote the code.&lt;br&gt;&lt;br&gt;&lt;b&gt;Fix:&lt;/b&gt; Use an independent evaluator and a golden / reference set." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d64545;strokeWidth=1.6;fontColor=#1f2937;fontSize=13;align=left;verticalAlign=top;spacingLeft=34;spacingRight=18;spacingTop=14;" vertex="1" parent="pg3-layer"><mxGeometry x="40" y="320" width="770" height="156" as="geometry"/></mxCell><mxCell id="pg3-B3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d64545;strokeColor=#d64545;" vertex="1" parent="pg3-layer"><mxGeometry x="40" y="320" width="14" height="156" as="geometry"/></mxCell><mxCell id="pg3-C4" value="&lt;b style=&quot;font-size:15px&quot;&gt;4 · Agents and Workflows&lt;/b&gt; &lt;span style=&quot;color:#d98324&quot;&gt;(Medium)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#6b7280&quot;&gt;Where: count++ / retry&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Issue:&lt;/b&gt; The loop counts attempts but does not pass failure details into the next attempt, so it can repeat the same mistake.&lt;br&gt;&lt;br&gt;&lt;b&gt;Fix:&lt;/b&gt; Feed assertion diffs, screenshots and errors into the next iteration." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d98324;strokeWidth=1.6;fontColor=#1f2937;fontSize=13;align=left;verticalAlign=top;spacingLeft=34;spacingRight=18;spacingTop=14;" vertex="1" parent="pg3-layer"><mxGeometry x="850" y="320" width="770" height="156" as="geometry"/></mxCell><mxCell id="pg3-B4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d98324;strokeColor=#d98324;" vertex="1" parent="pg3-layer"><mxGeometry x="850" y="320" width="14" height="156" as="geometry"/></mxCell><mxCell id="pg3-C5" value="&lt;b style=&quot;font-size:15px&quot;&gt;5 · Output format&lt;/b&gt; &lt;span style=&quot;color:#d98324&quot;&gt;(Medium)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#6b7280&quot;&gt;Where: Structured JSON&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Issue:&lt;/b&gt; The output JSON has no schema or version, so every later step guesses its shape.&lt;br&gt;&lt;br&gt;&lt;b&gt;Fix:&lt;/b&gt; Pin a versioned JSON Schema and validate it before the dev loop starts." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d98324;strokeWidth=1.6;fontColor=#1f2937;fontSize=13;align=left;verticalAlign=top;spacingLeft=34;spacingRight=18;spacingTop=14;" vertex="1" parent="pg3-layer"><mxGeometry x="40" y="510" width="770" height="156" as="geometry"/></mxCell><mxCell id="pg3-B5" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d98324;strokeColor=#d98324;" vertex="1" parent="pg3-layer"><mxGeometry x="40" y="510" width="14" height="156" as="geometry"/></mxCell><mxCell id="pg3-C6" value="&lt;b style=&quot;font-size:15px&quot;&gt;6 · Source conflicts&lt;/b&gt; &lt;span style=&quot;color:#6b7280&quot;&gt;(Low)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#6b7280&quot;&gt;Where: Input sources&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Issue:&lt;/b&gt; No rule for what wins when JIRA, persona.md and Figma disagree.&lt;br&gt;&lt;br&gt;&lt;b&gt;Fix:&lt;/b&gt; Define a source-of-truth order and flag conflicts instead of resolving them silently." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;strokeWidth=1.6;fontColor=#1f2937;fontSize=13;align=left;verticalAlign=top;spacingLeft=34;spacingRight=18;spacingTop=14;" vertex="1" parent="pg3-layer"><mxGeometry x="850" y="510" width="770" height="156" as="geometry"/></mxCell><mxCell id="pg3-B6" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6b7280;strokeColor=#6b7280;" vertex="1" parent="pg3-layer"><mxGeometry x="850" y="510" width="14" height="156" as="geometry"/></mxCell><mxCell id="pg3-C7" value="&lt;b style=&quot;font-size:15px&quot;&gt;7 · Human oversight&lt;/b&gt; &lt;span style=&quot;color:#d98324&quot;&gt;(Medium)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#6b7280&quot;&gt;Where: Stop&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Issue:&lt;/b&gt; Nothing reviews the result, and hitting the 5-iteration cap ends in the same Stop as a success.&lt;br&gt;&lt;br&gt;&lt;b&gt;Fix:&lt;/b&gt; Add an approval step and treat the cap-exceeded exit as a failure that needs review." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d98324;strokeWidth=1.6;fontColor=#1f2937;fontSize=13;align=left;verticalAlign=top;spacingLeft=34;spacingRight=18;spacingTop=14;" vertex="1" parent="pg3-layer"><mxGeometry x="40" y="700" width="770" height="156" as="geometry"/></mxCell><mxCell id="pg3-B7" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d98324;strokeColor=#d98324;" vertex="1" parent="pg3-layer"><mxGeometry x="40" y="700" width="14" height="156" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
